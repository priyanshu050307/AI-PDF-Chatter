# AI PDF Chatter — Environment Configuration Example

# Application
APP_NAME="AI PDF Chatter"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL + pgvector)
POSTGRES_USER=pdfuser
POSTGRES_PASSWORD=pdfpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pdfchatter
DATABASE_URL="postgresql+asyncpg://pdfuser:pdfpassword@localhost:5432/pdfchatter"

# Security / Authentication
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION_32_BYTES_MIN"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Redis Queue & Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Object Storage (MinIO / S3)
STORAGE_BACKEND="local" # Options: "local", "s3", "minio"
LOCAL_STORAGE_DIR="./storage_data"
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_NAME="pdfchatter-documents"
S3_REGION="us-east-1"

# AI Provider Credentials (Reserved for later phases)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
COHERE_API_KEY=""
